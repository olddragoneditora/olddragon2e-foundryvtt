{
  "private": true,
  "name": "olddragon2e",
  "description": "FoundryVTT System for Old Dragon 2e",
  "license": "https://creativecommons.org/licenses/by-sa/4.0/deed.pt-br",
  "homepage": "https://foundryvtt.com/packages/olddragon2e",
  "repository": {
    "type": "git",
    "url": "https://github.com/olddragoneditora/olddragon2e-foundryvtt"
  },
  "bugs": {
    "url": "https://github.com/olddragoneditora/olddragon2e-foundryvtt/issues"
  },
  "contributors": [],
  "type": "module",
  "scripts": {
    "build": "gulp build",
    "build:watch": "gulp watch",
    "link-project": "gulp link",
    "clean": "gulp clean",
    "clean:link": "gulp link --clean",
    "lint": "eslint --ext .js,.cjs,.mjs .",
    "lint:fix": "eslint --ext .js,.cjs,.mjs --fix .",
    "format": "prettier --write \"./**/*.(js|cjs|mjs|json|yml|less)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=junit --outputFile=junit.xml",
    "packs:extract": "node scripts/manage-packs.mjs extract",
    "packs:extract:dist": "node scripts/manage-packs.mjs extract:dist",
    "packs:pack": "node scripts/manage-packs.mjs pack",
    "packs:sync": "node scripts/manage-packs.mjs extract:dist && node scripts/manage-packs.mjs pack && gulp build",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.3.6",
    "gulp": "^5.0.1",
    "gulp-less": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "less": "^4.7.0",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "vitest": "^4.1.10",
    "yargs": "^18.0.0"
  },
  "lint-staged": {
    "*.(js|cjs|mjs)": "eslint --fix",
    "*.(json|yml|less)": "prettier --write"
  }
}
