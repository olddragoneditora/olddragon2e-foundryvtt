<div class="form-group">
    <label>{{localize "olddragon2e.dialog.formula"}}</label>
    <input type="text" name="formula" value="{{formula}}" disabled>
</div>
<div class="form-group">
    <label>{{localize "olddragon2e.dialog.test_adjustment"}}</label>
    <select name="adjustment" id="adjustment">
        <option value="none" selected>{{localize "olddragon2e.dialog.adjustments.none"}}</option>
        <option value="easy">{{localize "olddragon2e.dialog.adjustments.easy"}}</option>
        <option value="very-easy">{{localize "olddragon2e.dialog.adjustments.very_easy"}}</option>
        <option value="hard">{{localize "olddragon2e.dialog.adjustments.hard"}}</option>
        <option value="very-hard">{{localize "olddragon2e.dialog.adjustments.very_hard"}}</option>
    </select>
</div>
<div class="form-group">
    <label title="{{localize 'olddragon2e.dialog.optional_modifier_hint'}}">{{localize "olddragon2e.dialog.optional_modifier"}}&nbsp;<i class="fa-solid fa-circle-info"></i></label>
    <input type="text" name="bonus" id="bonus" value="">
</div>
<div class="form-group">
    <label>{{localize "olddragon2e.dialog.roll_mode"}}</label>
    <select name="rollMode" id="rollMode">
        <option value="public" selected>{{localize "CHAT.RollPublic"}}</option>
        <option value="private">{{localize "CHAT.RollPrivate"}}</option>
        <option value="blind">{{localize "CHAT.RollBlind"}}</option>
        <option value="self">{{localize "CHAT.RollSelf"}}</option>
    </select>
</div>
